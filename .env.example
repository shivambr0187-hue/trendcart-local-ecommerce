PORT=3000
NODE_ENV=development
# Set these before the first start. The initial admin is created once and is not reset on restart.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional; set a random value of at least 32 characters in production.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Optional path for persistent SQLite storage.
DATABASE_FILE=./data/trendcart.sqlite
